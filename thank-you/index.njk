---
title: "Thanks!"
description: "Thanks for subscribing to ClawDrop."
permalink: /thank-you/
eleventyExcludeFromCollections: true
---
{% extends "base.njk" %}

{% block styles %}
  .layout { display: flex; flex-direction: column; min-height: 100vh; }
  .content { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 70px 28px; }
  .hero-emoji { font-size: 4rem; margin-bottom: 32px; display: inline-block; }
  h1 { font-family: 'Fraunces', serif; font-size: clamp(2.2rem, 5vw, 3rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.05; margin-bottom: 20px; color: var(--ink); }
  h1 em { font-style: italic; color: var(--accent); font-weight: 500; }
  .email-alert { background: var(--accent-soft); border: 1px solid var(--rule); border-radius: 14px; padding: 26px 30px; max-width: 480px; margin: 0 auto 36px; text-align: left; }
  .email-alert p { font-size: 1rem; color: var(--ink); line-height: 1.55; }
  .email-alert .check { font-weight: 600; margin-bottom: 12px; }
  .email-alert .check span { color: var(--ink-mute); font-weight: 400; }
  .email-alert .reply strong { color: var(--accent); font-weight: 600; }
  .message { font-size: 1.05rem; color: var(--ink-soft); line-height: 1.65; max-width: 480px; margin: 0 auto 36px; }
  .message strong { color: var(--ink); font-weight: 600; }
  .cta-col { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .cta-btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 28px; border-radius: 100px; font-size: 0.95rem; font-weight: 600; text-decoration: none; background: var(--accent); color: white; transition: all 0.2s; }
  .cta-btn:hover { background: var(--accent-hover); transform: translateY(-1px); color: white; }
  .cta-secondary { font-size: 0.88rem; color: var(--ink-soft); text-decoration: none; }
  .cta-secondary:hover { color: var(--accent); }
{% endblock %}

{% block body %}
<section class="content">
            <div class="hero-emoji">🪝</div>
            <h1>You're <em>in.</em></h1>
            <div class="email-alert">
                <p class="check">📬 Check your email for a welcome message <span>(check spam too).</span></p>
                <p class="reply"><strong>Reply and tell me how you want to use OpenClaw.</strong> It keeps future emails out of spam.</p>
            </div>

            <p class="message">
                <strong>First drop hits your inbox Tuesday.</strong> In the meantime, got a build worth sharing? Submit it and we might feature it in a future issue.
            </p>

            <div class="cta-col">
                <a href="/submit/" class="cta-btn">🔧 Submit a build</a>
                <a href="/archives/" class="cta-secondary">or browse past issues →</a>
            </div>
        </section>
{% endblock %}
